# Python
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/

# macOS
.DS_Store
**/.DS_Store
.zsh_history

# Logs and backups
# Note: on a case-insensitive filesystem '*.log' also matches the engine's 'engine_*.LOG'.
# That is intended for transient state, but archived run evidence is re-included
# below (loop.log_archive_dir).
*.log
**/*.log
*.bak
**/*.bak
*.BAK
**/*.BAK

# Engine preserved run logs — deliberately retained as run evidence
!ai/logs/
!ai/logs/**

# Run logs cited as evidence in a dev/audit report — retained with the report
!dev/audit/logs-*/
!dev/audit/logs-*/**

# Obsidian
.obsidian/
*.canvas

# AI framework
workspace/report/
workspace/proposal/
workspace/proposal/closed/

# Engine ephemeral state
ai/state/

# dev/smoke harness — propagated framework copy, generated deliverable, and
# engine-mcp run records. The harness definition (task.md, tests/,
# config.reference.yaml) and dev/smoke-fixtures/ remain tracked.
dev/smoke/ai/
dev/smoke/src/
dev/smoke/.ael/
dev/eval/.venv/
dev/eval/.env
dev/eval/results/

# Model-specific configs (local only)
.model-config.local.yaml

# other
deprecated/
10000
test.txt
**/tmp
*.pdf
project_information.md

# Generated monitoring output — overwritten every scan cycle
overwatch.html
ai/dashboard-alerts.md

# Claude Code local settings (P01 §1.2.2)
.claude/settings.local.json

# Migration snapshots — working safety net for the duration of a change.
# The durable pre-migration record is the git tag, not this directory.
dev/backup/
